{
  "name": "@aop/desktop",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "license": "MIT",
  "author": "AOP contributors",
  "description": "AOP desktop app: a thin client for an AOP host, with a bundled dashboard.",
  "scripts": {
    "build": "vite build && bun run bundle:dashboard && bun run build:electron",
    "build:electron": "bun run ../../scripts/desktop/build-electron.ts",
    "builder": "electron-builder",
    "bundle:dashboard": "bun run ../../scripts/desktop/bundle-dashboard.ts",
    "dev": "vite --host 127.0.0.1",
    "electron:dev": "bun run ../../scripts/desktop/dev-electron.ts",
    "prepare:host": "bun run ../../scripts/desktop/prepare-electron-resources.ts",
    "test": "bun test src/**/*.test.ts src/**/*.test.tsx electron/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aop/common": "workspace:*",
    "@fontsource-variable/inter": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "happy-dom": "^20.11.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  },
  "private": true
}
