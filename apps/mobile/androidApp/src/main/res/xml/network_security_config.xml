<?xml version="1.0" encoding="utf-8"?>
<!--
  HTTPS only, with the system's certificate authorities (tailscale serve's *.ts.net certificates
  come from Let's Encrypt). Plain HTTP is allowed only to this device and to the emulator's alias
  for the computer it runs on, which is how a development host is reached.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
