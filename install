#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd)

if command -v bun >/dev/null 2>&1; then
  exec bun "$SCRIPT_DIR/scripts/source-install.ts" "$@"
fi

if command -v npx >/dev/null 2>&1; then
  exec npx --yes bun "$SCRIPT_DIR/scripts/source-install.ts" "$@"
fi

echo "AOP install requires bun or npx on PATH." >&2
exit 127
