{
  "name": "@aop/e2e-tests",
  "version": "0.9.35",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test:e2e": "AOP_RUN_E2E=1 bun test --concurrency 1 ./src/*.e2e.ts",
    "test:e2e:dashboard": "AOP_RUN_E2E=1 bun test --concurrency 1 ./src/dashboard.e2e.ts",
    "test:e2e:codex-benchmark": "bun run ../scripts/run-codex-e2e-benchmark.ts",
    "benchmark:codex:aop": "bun run ../scripts/run-aop-codex-benchmark.ts",
    "benchmark:codex:pure": "bun run ../scripts/run-pure-codex-benchmark.ts",
    "benchmark:codex:compare": "bun run ../scripts/compare-codex-benchmarks.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aop/cli": "workspace:*",
    "@aop/common": "workspace:*",
    "@aop/infra": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.8.0",
    "playwright": "^1.61.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3"
  }
}
